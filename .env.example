# ==========================================
# ZAYA Platform — Environment Configuration
# ==========================================

# Database: SQLite for zero-config local development, or PostgreSQL for production
DATABASE_URL="file:./dev.db"
# Example PostgreSQL Production connection:
# DATABASE_URL="postgresql://zaya_user:secret_password@db.supabase.co:5432/zaya_db?sslmode=require"

# Application URL
NEXT_PUBLIC_APP_URL="https://zaya.ma"
NEXT_PUBLIC_COUNTRY="MA"
NEXT_PUBLIC_DEFAULT_LOCALE="fr"

# Payment Providers (Optional credentials for live gateways)
# CMI (Centre Monétique Interbancaire - Morocco)
CMI_MERCHANT_ID=""
CMI_STORE_KEY=""
CMI_GATEWAY_URL="https://testpayment.cmi.co.ma/fim/est3Dgate"

# Stripe (Optional international payment gateway)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Notifications & Messaging (Morocco WhatsApp Cloud API / Infobip)
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

# S3-Compatible Object Storage (Private documents & medical certificates)
S3_BUCKET=""
S3_REGION="eu-west-3"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
